{
  "name": "@loyalid/layout-builder",
  "version": "1.3.1",
  "description": "Layout Builder UI + JSON-to-HTML Renderer for CMS. Bootstrap 4/5, Tailwind CSS, Native CSS.",
  "main": "dist/index.js",
  "module": "src/index.js",
  "types": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["layout", "builder", "cms", "bootstrap", "tailwind", "renderer", "html", "json", "wysiwyg"],
  "author": "loyalid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/babaecip/loyalid-layout-builder.git"
  },
  "homepage": "https://github.com/babaecip/loyalid-layout-builder#readme",
  "bugs": {
    "url": "https://github.com/babaecip/loyalid-layout-builder/issues"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "@rollup/plugin-terser": "^0.4.0"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  }
}
